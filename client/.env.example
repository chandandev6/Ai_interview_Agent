VITE_FIREBASE_API_KEY=
# local: http://localhost:8000. On Vercel leave it UNSET — calls go to /api on the same site (vercel.json proxies them
# to Render), so the login cookie is first-party and works in Safari too
VITE_SERVER_URL=http://localhost:8000
# Error monitoring: sentry.io → (React) project → Client Keys (DSN). Leave empty → Sentry off.
VITE_SENTRY_DSN=
