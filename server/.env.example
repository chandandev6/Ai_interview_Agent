PORT=8000
NODE_ENV=development
MONGODB_URL=mongodb://localhost:27017/ai_interview
MONGO_POOL_SIZE=50
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
FIREBASE_PROJECT_ID=aismartinterview-1dc3f
OPENROUTER_API_KEY=
# paid (fast, reliable JSON): anthropic/claude-haiku-4.5 — or free: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# optional backups tried when the main model is busy (useful for :free models), comma-separated
OPENROUTER_FALLBACK_MODELS=

# Email (verification links). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>. Leave empty in dev → links print in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
