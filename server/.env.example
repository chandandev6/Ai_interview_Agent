PORT=8000
NODE_ENV=development
MONGODB_URL=mongodb://localhost:27017/ai_interview
MONGO_POOL_SIZE=50
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
FIREBASE_PROJECT_ID=aismartinterview-1dc3f
OPENROUTER_API_KEY=
# paid (fast, reliable JSON): anthropic/claude-haiku-4.5 — or free: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# optional backups tried when the main model is busy (useful for :free models), comma-separated
OPENROUTER_FALLBACK_MODELS=

# Email (verification links). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>. Leave empty in dev → links print in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payments (Razorpay). Dashboard → Test Mode → Account & Settings → API Keys. Leave empty → buying credits is disabled.
# Webhook: Dashboard → Webhooks → URL https://<your-server>/api/payment/webhook, events payment.captured + payment.failed,
# and put the secret you type there in RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis (rate limits + cache + job queue). Required. Local: run `docker compose up -d` in the repo root.
REDIS_URL=redis://localhost:6380
# How many AI jobs one worker process runs at the same time (npm run worker)
WORKER_CONCURRENCY=10
# true = the API process also runs the job workers (Render free plan has no background workers). Locally keep false
# and run `npm run dev:worker` in its own terminal
RUN_WORKER_IN_API=false
# Production only: how many proxies sit in front of the server. Render alone = 1, Vercel /api proxy + Render = 2
TRUST_PROXY_HOPS=1

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Error monitoring: sentry.io → Project → Settings → Client Keys (DSN). Leave empty → Sentry off.
SENTRY_DSN=
